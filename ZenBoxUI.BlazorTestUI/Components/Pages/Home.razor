@inject IZBoxToastService ToastService
@inject NavigationManager NavManager

@rendermode @(new InteractiveServerRenderMode(prerender:false))
@page "/"

<PageTitle>Home</PageTitle>

<div class="p-2">
  <h1 style="justify-self: center;">ZenboxUI Components</h1>
  
  <hr />

  <h2>Input Components</h2>

  <button class="btn btn-primary" @onclick="NavigateToTextInput"> Text Input</button>
  <button class="btn btn-primary" @onclick="NavigateToNumberInput">Number Input</button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Text Area Input</strike></button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Date Input</strike></button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Date Range Input</strike></button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Time Input</strike></button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Time Range Input</strike></button>
  <button class="btn btn-primary" @onclick="NavigateToTextInput"><strike>Drop Down Input</strike></button>



  <h2>Toast Components</h2>
  <button class="btn btn-primary" @onclick="NavigateToToast">Toast Examples</button>
</div>

@code{
  private void NavigateToTextInput() => NavManager.NavigateTo("/InputText");
  private void NavigateToNumberInput() => NavManager.NavigateTo("/InputNumber");
  private void NavigateToToast() => NavManager.NavigateTo("/Toast");
}
