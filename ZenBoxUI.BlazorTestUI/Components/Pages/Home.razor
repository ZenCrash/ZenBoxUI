@code{
  private ZBoxToastProvider? _toastProvider;

  private void ShowToast(ToastRenderStyle toastStyle)
  {
    // Generate the toast options based on the style
    ToastOptions CreateToast() => toastStyle switch
    {
      ToastRenderStyle.Primary => new ToastOptions
      {
        Title = "Iam  'Basic, Primary' Toast" + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Primary,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Secondary => new ToastOptions
      {
        Title = "Iam  'Basic, Secondary' Toast" + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Secondary,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Warning => new ToastOptions
      {
        Title = "Iam  'Basic, Primary' Toast" + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Warning,
        DisplayTime = 3000,
      },
    };
  }

}
