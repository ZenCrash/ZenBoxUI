@inject IZBoxToastService ToastService

@rendermode @(new InteractiveServerRenderMode(prerender:false))
@page "/"


<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<h1>Iam example Text Iam example Text Iam example Text Iam example Text</h1>

<button class="btn btn-success" @onclick="() => ShowToast(ToastRenderStyle.Success)">Show Success Toast</button>
<button class="btn btn-danger" @onclick="() => ShowToast(ToastRenderStyle.Danger)">Show Danger Toast</button>
<button class="btn btn-warning" @onclick="() => ShowToast(ToastRenderStyle.Warning)">Show Warning Toast</button>
<button class="btn btn-info" @onclick="() => ShowToast(ToastRenderStyle.Info)">Show Info Toast</button>
<button class="btn btn-light" @onclick="() => ShowToast(ToastRenderStyle.Light)">Show Light Toast</button>
<button class="btn btn-dark" @onclick="() => ShowToast(ToastRenderStyle.Dark)">Show Dark Toast</button>

<span></span>

<button class="btn btn-primary" @onclick="ShowLongToast">Show Long Toast</button>


<ZBoxToastProvider
    MaxToastCount="5" 
    Alignment="ToastAlignment.BottomRight" 
    MaxWidth="300px"
    ShowCloseButton="true"
/>

@code{
  private ZBoxToastProvider? _toastProvider;

  private void ShowLongToast()
  {
    ToastService.ShowToast(new ToastOptions
    {
      Title = "Long Toast " + Guid.NewGuid(),
      Text = "Iam a toast with a really long text" + String.Concat(Enumerable.Repeat(Guid.NewGuid(), 15)),
      RenderTheme = ToastRenderTheme.Basic,
      RenderStyle = ToastRenderStyle.Info,
      DisplayTime = 0,
      CustomContent = 
      @<div>
        <button class="btn btn-primary" @onclick="() => ShowToast(ToastRenderStyle.Info)">Show Info Toast</button>
      </div>
    });
  }


  private void ShowToast(ToastRenderStyle toastStyle)
  {
    // Create toast immediately
    var toast = toastStyle switch
    {
      ToastRenderStyle.Success => new ToastOptions
      {
        Title = "Success Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Success,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Danger => new ToastOptions
      {
        Title = "Danger Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Danger,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Warning => new ToastOptions
      {
        Title = "Warning Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Warning,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Info => new ToastOptions
      {
        Title = "Info Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Info,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Light => new ToastOptions
      {
        Title = "Light Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Light,
        DisplayTime = 3000,
      },
      ToastRenderStyle.Dark => new ToastOptions
      {
        Title = "Dark Toast " + Guid.NewGuid(),
        Text = "This toast appears only on this page",
        RenderTheme = ToastRenderTheme.Basic,
        RenderStyle = ToastRenderStyle.Dark,
        DisplayTime = 3000,
      },
      _ => throw new ArgumentOutOfRangeException(nameof(toastStyle), "Invalid toast style")
    };

    // Add toast immediately
    ToastService.ShowToast(toast);
  }

}
