@inject IZBoxToastService ToastService
@inject NavigationManager NavManager

@rendermode @(new InteractiveServerRenderMode(prerender:false))
@page "/"

<PageTitle>Home</PageTitle>

<button class="btn btn-primary" @onclick="NavigateToTextInput">Text Input Examples</button>
<button class="btn btn-primary" @onclick="NavigateToToast">Toast Examples</button>

@code{
  private void NavigateToTextInput() => NavManager.NavigateTo("/InputText");
  private void NavigateToToast() => NavManager.NavigateTo("/Toast");
}
