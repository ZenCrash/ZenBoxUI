@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Disabled</h1>

  <p class="my-4">
    The text field can be masked by using the <span class="zb-code">Password</span> field.
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbTextInput CssClass="zb-demo-width" @bind-Value="@_text" Disabled="@_isDisabled" ClearButton="true" />
      <div class="pt-1 pb-2">
        <button @onclick="() => _isDisabled = !_isDisabled">Disabled toggle: (@_isDisabled)</button>
      </div>
      <ul>
        <li><span class="zb-code">Disabled</span> - Disables input</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {
  private string? _text { get; set; } = "John Doe";
  private bool _isDisabled { get; set; } = true;
  private string _codeExample = null!;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "Pages", "Components",
      "InputText", "CodeSnippets", "InputTextDisabled.razor.txt"
    );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}