@using System.ComponentModel.DataAnnotations
@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Validation</h1>

  <p class="my-4">
    The <span class="zb-code">@("<")ZbInputText@(">")</span>, can be bound to a variable by using <span class="zb-code">@@bind-Text</span>
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <EditForm Model="@model">
        <DataAnnotationsValidator/>
        <ZbTextInput @bind-Text="@model.Password" ClearButton="true" />
        <ValidationMessage For="@(() => model.Password)" />
        <div class="pt-1 pb-2">
          <button type="submit">Submit</button>
        </div>
      </EditForm>

      <p class="pt-1 pb-2">Text value: @(model.Password == null ? "Null" : model.Password == string.Empty ? "String.Empty" : model.Password)</p>

      <ul>
        <li><span class="zb-code">@@bind-Text</span> - Binds text to a variable</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {
  private string _codeExample;

  private InputTextValidationUserModel model { get; set; } = new();

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "CodeSnippets", "InputTextBind.razor.txt"
      );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}
