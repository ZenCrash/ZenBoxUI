@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Password</h1>

  <p class="my-4">
    The text field can be masked by using the <span class="zb-code">Password</span> field.
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbTextInput CssClass="zb-demo-width" @bind-Text="@_text" Password="@_isPassword" />
      <div class="pt-1 pb-2">
        <button @onclick="() => _isPassword = !_isPassword">Password toggle: (@_isPassword)</button>
      </div>
      <ul>
        <li><span class="zb-code">Password</span> - Masks the text field to password</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {
  private string? _text { get; set; } = "Password1!";
  private bool _isPassword { get; set; } = true;
  private string _codeExample;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "CodeSnippets", "InputTextPassword.razor.txt"
    );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}
