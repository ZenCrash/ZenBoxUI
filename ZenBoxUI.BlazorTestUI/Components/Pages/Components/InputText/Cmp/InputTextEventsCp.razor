@using ZenBoxUI.Blazor.Components.Snippet


<ZbSnippet>
  <ZbSnippetContent>
    <ZbTextInput Id="TestId"
                 InputId="InputTestId"
                 OnInput="@TriggerOnInput"
                 OnChange="@TriggerOnChange"
                 OnBlur="@TriggerOnBlur"
                 OnFocus="@TriggerOnFocus"
                 @bind-Text="@_text" />
    <p class="pt-1 pb-4">Text value: @(_text == null ? "Null" : _text == string.Empty ? "String.Empty" : _text)</p>
  </ZbSnippetContent>
  <ZbSnippetFile Name="Example.razor">
    <InputTextEventsCode />
  </ZbSnippetFile>
</ZbSnippet>

@code {
  private enum Source{Example, Code}
  private Source _selectedSource { get; set; }

  [Parameter] public IZBoxToastService ToastService { get; set; } = null!;
  private string? _text { get; set; }

  private void TriggerOnInput()
  {
    ToastService.ShowToast(new ToastOptions
    {
      Title = "Text - OnInput" + " " + Guid.NewGuid(),
      Text = "I got trigger On Input",
      RenderTheme = ToastRenderTheme.Basic,
      RenderStyle = ToastRenderStyle.Info,
      DisplayTime = 2000
    });
  }
  private void TriggerOnChange()
  {
    ToastService.ShowToast(new ToastOptions
    {
      Title = "Text - OnChange" + " " + Guid.NewGuid(),
      Text = "I got trigger On Change",
      RenderTheme = ToastRenderTheme.Basic,
      RenderStyle = ToastRenderStyle.Warning,
      DisplayTime = 2000
    });
  }

  private void TriggerOnFocus()
  {
    ToastService.ShowToast(new ToastOptions
    {
      Title = "Text - OnFocus" + " " + Guid.NewGuid(),
      Text = "I got trigger On Focus",
      RenderTheme = ToastRenderTheme.Basic,
      RenderStyle = ToastRenderStyle.Success,
      DisplayTime = 2000
    });
  }

  private void TriggerOnBlur()
  {
    ToastService.ShowToast(new ToastOptions
    {
      Title = "Text - OnBlur" + " " + Guid.NewGuid(),
      Text = "I got trigger On Blur (Deselect)",
      RenderTheme = ToastRenderTheme.Basic,
      RenderStyle = ToastRenderStyle.Danger,
      DisplayTime = 2000
    });
  }
}
