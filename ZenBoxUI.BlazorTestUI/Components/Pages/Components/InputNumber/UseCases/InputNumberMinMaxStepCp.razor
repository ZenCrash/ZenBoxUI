@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>MinValue, MaxValue & Increment</h1>

  <p class="my-4">
    To impose limits on the value  <span class="zb-code">@@bind-Text</span>
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbNumberInput CssClass="zb-demo-width" @bind-Value="@_value" MinValue="-1" MaxValue="101" Increment="5"/>
      <p class="pt-1 pb-2">Value: @(_value == null ? "Null" : _value)</p>
    
      <ul>
        <li><span class="zb-code">MinValue</span> - Max value the input is allowed to be</li>
        <li><span class="zb-code">MaxValue</span> - Min value the input is allowed to be</li>
        <li><span class="zb-code">Increment</span> - Incremental value when using the increment buttons</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>


@code {

  private int? _value { get; set; } = 0;
  private string _codeExample = null!;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "Pages", "Components", 
      "InputNumber", "CodeSnippets", "InputNumberMinMaxStepCp.razor.txt"
      );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}
