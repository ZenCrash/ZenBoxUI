@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Null Text</h1>

  <p class="my-4">
    When no text is null or no text is provided, the <span class="zb-code">NullText</span> will be displayed.
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbNumberInput CssClass="zb-demo-width" @bind-Value="@_value" NullText="Name of person..." />
      <p class="pt-1 pb-2">Value: @(_value == null ? "Null" : _value)</p>
    
      <ul>
        <li><span class="zb-code">NullText</span> - Sets display text, when field is null or empty</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {
  private int? _value { get; set; }
  private string _codeExample = null!;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "Pages", "Components",
      "InputNumber", "CodeSnippets", "InputNumberNullText.razor.txt"
    );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}
