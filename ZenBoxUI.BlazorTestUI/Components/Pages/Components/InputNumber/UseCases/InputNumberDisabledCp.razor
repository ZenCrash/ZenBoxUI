@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Disabled</h1>

  <p class="my-4">
    The Value field can be masked by using the <span class="zb-code">Password</span> field.
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbNumberInput CssClass="zb-demo-width" @bind-Value="@_value" Disabled="@_isDisabled" ClearButton="true" />
      <div class="pt-1 pb-2">
        <button @onclick="() => _isDisabled = !_isDisabled">Disabled toggle: (@_isDisabled)</button>
      </div>
      <ul>
        <li><span class="zb-code">Disabled</span> - Disables input</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {
  private int? _value { get; set; } = 0;
  private bool _isDisabled { get; set; } = true;
  private string _codeExample;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "CodeSnippets", "InputTextDisabled.razor.txt"
    );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}