@using ZenBoxUI.Blazor.Components.Snippet

<div>
  <h1>Bind Text</h1>

  <p class="my-4">
    The <span class="zb-code">@("<")ZbInputText@(">")</span>, can be bound to a variable by using <span class="zb-code">@@bind-Text</span>
  </p>

  <ZbSnippet>
    <ZbSnippetContent>
      <ZbNumberInput CssClass="zb-demo-width" @bind-Value="@_value"/>
      <p class="pt-1 pb-2">Number value: @_value</p>
    
      <ul>
        <li><span class="zb-code">@@bind-Text</span> - Binds Text to a variable</li>
      </ul>
    </ZbSnippetContent>
    <ZbSnippetFile Name="Example.razor">
      <CodeHighlight Code="@_codeExample" CodeLanguage="razor" />
    </ZbSnippetFile>
  </ZbSnippet>
</div>

@code {

  private int? _value { get; set; } = 1;
  private string _codeExample = null!;

  protected override void OnInitialized()
  {
    var path = Path.Combine(Directory.GetCurrentDirectory(),
      "Components", "CodeSnippets", "InputTextBind.razor.txt"
      );
    _codeExample = File.ReadAllText(path).Replace("\r\n", "\n");
  }
}
