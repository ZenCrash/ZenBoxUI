@using ZenBoxUI.BlazorTestUI.Components.Pages.Components.InputNumber.UseCases
@inject IZBoxToastService ToastService
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@page "/InputNumber"

<ZBoxToastProvider MaxToastCount="5"
                   Alignment="ToastAlignment.BottomRight"
                   MaxWidth="300px"
                   ShowCloseButton="true" />

<div class="d-flex flex-column" style="height:100vh">
  <div class="p-2" style="background-color:dodgerblue; color: white;">
    <h1>Inputs > Text</h1>
  </div>

  @* Input Triggers *@
  <div class="p-2 pt-4 d-flex flex-column gap-5 overflow-y-auto">
    <InputNumberBindCp />
    <InputNumberEventsCp ToastService="@ToastService" />
    <InputNumberDisabledCp />
    <InputNumberNullTextCp/>
    <InputNumberClearButtonCp />
    <InputNumberValidationCp />
  </div>
</div>
