@namespace ZenBoxUI.Blazor

@using Microsoft.JSInterop
@using ZenBoxUI.Blazor
@inject IZBoxToastService ToastService
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (!Enabled) return;

<CascadingValue Value="this">

<div class="@_cssClass zbox" style="z-index: @Zindex;">
  @if (Order == ToastOrder.Ascending)
  {
    // Loop for ascending order
    for (int i = 0; i < _toasts.Count && i < MaxToastCount; i++)
    {
      @switch (_toasts[i].RenderTheme)
      {
        case ToastRenderTheme.Basic:
            <ToastThemeBasic @key="_toasts[i].Id" ToastOptions="@_toasts[i]" DisplayTime="@DisplayTime" MaxWidth="@MaxWidth" CloseToast="@RemoveToast" />
          break;
      }
    }
  }
  else
  {
    @for (int i = _toasts.Count - 1; i >= 0 && i >= _toasts.Count - MaxToastCount; i--)
    {
      @switch (_toasts[i].RenderTheme)
      {
        case ToastRenderTheme.Basic:
            <ToastThemeBasic @key="_toasts[i].Id" ToastOptions="@_toasts[i]" DisplayTime="@DisplayTime" MaxWidth="@MaxWidth" />
          break;
      }
    }
  }
</div>
</CascadingValue>

@code {
  [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
  [Parameter] public bool Enabled { get; set; } = true;
  [Parameter] public ToastRenderTheme DefaultRenderTheme { get; set; }
  [Parameter] public ToastRenderStyle DefaultRenderStyle { get; set; }
  [Parameter] public bool ShowIcon { get; set; } = true;
  [Parameter] public bool ShowCloseButton { get; set; } = true;
  [Parameter] public string MaxWidth { get; set; } = "300px";
  [Parameter] public int MaxToastCount { get; set; } = 5;
  [Parameter] public int DisplayTime { get; set; } = 5000;
  [Parameter] public ToastOrder Order { get; set; } = ToastOrder.Ascending;
  [Parameter] public int Zindex { get; set; } = 3;
  // [Parameter] public ToastAnimation Animation { get; set; } = ToastAnimeation.Slide;
  [Parameter] public ToastAlignment Alignment { get; set; } = ToastAlignment.BottomRight;

  private string _cssClass { get; set; } = string.Empty;
  private List<ToastOptions> _toasts = new();
  private HashSet<string> _startedTimers = new();

  //-----------------------------//
  /* Main                        */
  //-----------------------------//

  protected override void OnInitialized()
  {
    _cssClass = ToastStyleBuilder.GetToastContainerStyles(Alignment);
    ToastService.OnToastAdded += AddToast;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    var visibleToasts = GetVisibleToasts();

    foreach (var toast in visibleToasts)
    {
      if (_startedTimers.Contains(toast.Id))
        continue;

      _startedTimers.Add(toast.Id);

      var delay = toast.DisplayTime ?? DisplayTime;

      if (delay > 0)
      {
        _ = RemoveToastAfterDelay(toast.Id, delay);
      }
    }
  }

  private IEnumerable<ToastOptions> GetVisibleToasts()
  {
    if (Order == ToastOrder.Ascending)
    {
      return _toasts.Take(MaxToastCount);
    }
    else
    {
      return _toasts
          .Skip(Math.Max(0, _toasts.Count - MaxToastCount))
          .Take(MaxToastCount);
    }
  }

  private async Task RemoveToastAfterDelay(string id, int delayMs)
  {
    await Task.Delay(delayMs);
    await InvokeAsync(() => RemoveToast(id));
  }

  private void AddToast(ToastOptions toast)
  {
    _toasts.Add(toast);
    InvokeAsync(StateHasChanged);
  }

  internal void RemoveToast(string id)
  {
    var toast = _toasts.FirstOrDefault(t => t.Id == id);
    if (toast == null) return;

    _toasts.Remove(toast);
    _startedTimers.Remove(id);

    InvokeAsync(StateHasChanged);
  }

  public void Dispose()
  {
    ToastService.OnToastAdded -= AddToast;
  }
}
