@using ZenBoxUI.Blazor
@namespace ZenBoxUI.Blazor.Toast.Themes

<div class="zbox-toast" style="@CssStyle">
  <div class="zbox-toast-header">
    <img src="_content/ZenBoxUI.Blazor/svg/check-circle-fill-white.svg" width="18" />
    <span class="zbox-toast-title">@ToastOptions.Title</span>
  </div>
  <div class="zbox-toast-body">
    @ToastOptions.Text
  </div>
</div>

@code {
  [CascadingParameter] ZBoxToastProvider? Parent { get; set; }
  [Parameter] public EventCallback<string> RemoveToast { get; set; }
  [Parameter] public ToastOptions ToastOptions { get; set; } = null!;
  [Parameter] public string MaxWidth { get; set; } = null!;
  [Parameter] public int? DisplayTime { get; set; }

  private string CssStyle { get; set; } = string.Empty;

  protected override void OnInitialized()
  {
    CssStyle = ToastStyleBuilder.GetToastStyles(MaxWidth, ToastOptions.RenderStyle, ToastOptions.Width);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && (ToastOptions.DisplayTime != null || DisplayTime.HasValue != null))
    {
      TimeSpan displayTime = TimeSpan.Zero;

      if (ToastOptions.DisplayTime is not null)
      {
        displayTime = (ToastOptions.DisplayTime != 0) ? TimeSpan.FromMilliseconds((double)ToastOptions.DisplayTime) : TimeSpan.Zero;
      }
      else
      {
        displayTime = (DisplayTime != 0) ? TimeSpan.FromMilliseconds((double)DisplayTime) : TimeSpan.Zero;
      }

      // await Task.Delay(displayTime).ContinueWith(_ => RemoveToast.InvokeAsync(ToastOptions.Id));
      await Task.Delay(displayTime).ContinueWith(_ => Parent.RemoveToast(ToastOptions.Id));

    }
  }
}
