@using ZenBoxUI.Blazor
@namespace ZenBoxUI.Blazor

<div class="zbox-toast" style="@CssStyle">
  <div class="zbox-toast-header">
    @if (ToastOptions.IconCssClass is null)
    {
      <img src="@IconPath" class="zbox-toast-icon" width="18" />
    }
    else
    {
      <i class="@ToastOptions.IconCssClass" />
    }
    <span class="zbox-toast-title">@ToastOptions.Title</span>
    <img src="_content/ZenBoxUI.Blazor/svg/x-lg.svg" class="zbox-toast-icon zbox-toast-close" width="18" @onclick="@CloseToastBtn" />
  </div>
  <div class="zbox-toast-body">
    <p class="zbox-toast-text">@ToastOptions.Text</p>
    @ToastOptions.CustomContent
  </div>
</div>

@code {
  [Parameter] public EventCallback<string> CloseToast { get; set; }
  [Parameter] public ToastOptions ToastOptions { get; set; } = null!;
  [Parameter] public string MaxWidth { get; set; } = null!;
  [Parameter] public int? DisplayTime { get; set; }

  private string CssStyle { get; set; } = string.Empty;
  private string IconPath { get; set; } = string.Empty;

  protected override void OnInitialized()
  {
    CssStyle = ToastStyleBuilder.GetToastStyles(MaxWidth, ToastOptions.RenderStyle, ToastOptions.Width, ToastOptions.MaxLineHeight!);
    IconPath = ToastStyleBuilder.GetIconPath(ToastOptions.RenderStyle);
  }

  private void CloseToastBtn()
  {
    CloseToast.InvokeAsync(ToastOptions.Id);
  }
}
