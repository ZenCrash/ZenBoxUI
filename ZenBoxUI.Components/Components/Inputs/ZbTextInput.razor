@using ZenBoxUI.Blazor.Common;
@namespace ZenBoxUI.Blazor

@inherits ZbInputBase<string?>

<div id="@Id" class="@WrapperClass">
  <input id="@InputId"
         type="@(IsPassword ? "password" : "text")"
         class="@InputClass"
         value="@_value"
         placeholder="@NullText"
         disabled="@Disabled"
         @oninput="@HandleInput"
         @onchange="@HandleChange"
         @onfocus="@HandleFocus"
         @onblur="@HandleDeselect" />

  @if (_displayClearButton)
  {
    <button type="button"
            class="zb-clear-btn"
            @onmousedown:preventDefault
            @onclick="@ClearInput">
      <i class="zbi zbi-x"></i>
    </button>
  }
  
  @if (PasswordToggleButton && !Disabled)
  {
    <button type="button"
            class="zb-input-action-btn"
            @onmousedown:preventDefault
            @onclick="@TogglePassword">
      <i class="@(IsPassword ? "zbi zbi-eye-fill" : "zbi zbi-eye-slash-fill")"></i>
    </button>
  }
</div>