@using ZenBoxUI.Blazor.Common;
@using System.Numerics;
@namespace ZenBoxUI.Blazor
@typeparam TValue where TValue : INumber<TValue>
@inherits ZbInputBase<TValue> 

<div id="@Id" class="@WrapperClass">
  <input id="@InputId"
         type="number"
         class="@InputClass"
         value="@_value"
         placeholder="@NullText"
         disabled="@Disabled"
         readonly="@ReadOnly"
         min="@(MinValue is null ? null : MinValue.ToString())"
         max="@(MaxValue is null ? null : MaxValue.ToString())"
         step="@(Increment is null ? 1 : Increment.ToString())"
         @onkeydown:preventDefault="@DisabledIncrementHotKeys"
         @onwheel:preventDefault="@DisabledIncrementHotKeys"
         @oninput="@HandleInput"
         @onchange="@HandleChange"
         @onfocus="@HandleFocus"
         @onblur="@HandleDeselect" />

  @if (_displayClearButton)
  {
    <button type="button"
            class="zb-clear-btn"
            disabled="@(Disabled || ReadOnly)"
            @onmousedown:preventDefault
            @onclick="@ClearInput">
      <i class="zbi zbi-x"></i>
    </button>
  }
  
  @if (!DisableIncrementButtons && !Disabled)
  {
    <div class="zb-input-actions">
      <button type="button"
              class="zb-input-action-btn"
              disabled="@(Disabled || ReadOnly)"
              @onmousedown:preventDefault
              @onclick="@IncrementValue">
        <i class="zbi zbi-chevron-up"></i>
      </button>
      <button type="button"
              class="zb-input-action-btn"
              disabled="@(Disabled || ReadOnly)"
              @onmousedown:preventDefault
              @onclick="@DecrementValue">
        <i class="zbi zbi-chevron-down"></i>
      </button>
    </div>
  }
</div>